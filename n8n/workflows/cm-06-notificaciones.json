{
  "id": "cm06Notificaciones",
  "name": "CM-06 · Notificaciones",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "cm99Errores",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "0f56f3e6-c448-5f98-9b2a-c2eef2535f78",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "a7f3e44c-569e-5eb5-a1eb-61de58ca1cd8",
      "name": "Ejecutar ahora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "0e8965d6-5a87-5771-a030-6caeb54824ea",
      "name": "Python: tomar avisos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CM_API_URL }}/api/internal/notifications/claim?limit=20",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        }
      },
      "notes": "Python marca los avisos como 'enviando': otra ejecución no los tomará."
    },
    {
      "id": "33ee508f-8ad1-54fc-8fd8-4dd2d4316370",
      "name": "Separar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        80
      ],
      "parameters": {
        "jsCode": "// Sin avisos pendientes, el flujo termina aquí (no se guarda la ejecución).\nreturn ($input.first().json.notifications || []).map(n => ({ json: n }));"
      }
    },
    {
      "id": "cf7fe332-1569-540d-b303-5d4580138564",
      "name": "Telegram: enviar aviso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.action.method }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.action.payload) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "589f4a2d-b5dd-5cab-870f-fb874c15b459",
      "name": "Preparar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        80
      ],
      "parameters": {
        "jsCode": "const sent = $('Separar avisos').all();\nreturn $input.all().map((item, i) => {\n  const r = item.json;\n  return { json: {\n    id: sent[i].json.id,\n    ok: r.ok === true,\n    error_code: r.ok === true ? null : (r.error_code ?? null),\n    description: r.ok === true ? null : String(r.description || r.error?.message || 'sin respuesta de Telegram').slice(0, 900),\n  }};\n});"
      }
    },
    {
      "id": "df935b8d-c9bd-580b-bfdf-cc07945190b2",
      "name": "Python: informar resultado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CM_API_URL }}/api/internal/notifications/{{ $json.id }}/result",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ok: $json.ok, error_code: $json.error_code, description: $json.description }) }}"
      },
      "notes": "Python decide: entregado, reintentar más tarde o no insistir (bot bloqueado)."
    }
  ],
  "connections": {
    "Cada minuto": {
      "main": [
        [
          {
            "node": "Python: tomar avisos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar ahora": {
      "main": [
        [
          {
            "node": "Python: tomar avisos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Python: tomar avisos": {
      "main": [
        [
          {
            "node": "Separar avisos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Separar avisos": {
      "main": [
        [
          {
            "node": "Telegram: enviar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: enviar aviso": {
      "main": [
        [
          {
            "node": "Preparar resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar resultado": {
      "main": [
        [
          {
            "node": "Python: informar resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
