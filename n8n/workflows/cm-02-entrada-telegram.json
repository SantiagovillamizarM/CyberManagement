{
  "id": "cm02EntradaTelegram",
  "name": "CM-02 · Entrada Telegram",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "5f0c2d6e-7a1b-4c3d-9e8f-0a1b2c3d4e01",
      "name": "Telegram (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "9b1e6f3a-2c4d-4e5f-8a7b-6c5d4e3f2a10",
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram",
        "responseMode": "onReceived",
        "options": {}
      },
      "notes": "Telegram llama aquí. Se responde 200 de inmediato para que Telegram no reintente."
    },
    {
      "id": "5f0c2d6e-7a1b-4c3d-9e8f-0a1b2c3d4e02",
      "name": "Python: procesar update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CM_API_URL }}/api/internal/telegram/updates",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}" },
            { "name": "X-Telegram-Secret", "value": "={{ $json.headers['x-telegram-bot-api-secret-token'] || '' }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "notes": "Python decide TODO (reglas, permisos, estado de la conversación) y devuelve una lista de acciones."
    },
    {
      "id": "5f0c2d6e-7a1b-4c3d-9e8f-0a1b2c3d4e03",
      "name": "Separar acciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0],
      "parameters": {
        "jsCode": "// Una acción = un ítem. Sin acciones, el flujo termina aquí.\nconst actions = $input.first().json.actions || [];\nreturn actions.map(action => ({ json: action }));"
      }
    },
    {
      "id": "5f0c2d6e-7a1b-4c3d-9e8f-0a1b2c3d4e04",
      "name": "Telegram: ejecutar acción",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 0],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 15000
        }
      },
      "notes": "Ejecuta cada acción tal cual (sendMessage, answerCallbackQuery...). No interpreta nada."
    }
  ],
  "connections": {
    "Telegram (webhook)": {
      "main": [[{ "node": "Python: procesar update", "type": "main", "index": 0 }]]
    },
    "Python: procesar update": {
      "main": [[{ "node": "Separar acciones", "type": "main", "index": 0 }]]
    },
    "Separar acciones": {
      "main": [[{ "node": "Telegram: ejecutar acción", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {}
}
