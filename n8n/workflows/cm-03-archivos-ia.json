{
  "id": "cm03ArchivosIA",
  "name": "CM-03 · Archivos e IA",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "2aa9c23f-46d6-59d5-8f15-acc92e37efab",
      "name": "Recibir archivo",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      },
      "notes": "Acción cm:store_file de Python: {file_id, telegram_user_id, purpose, ...}."
    },
    {
      "id": "ea4fa3bf-4900-5bf3-8a5e-c4eb9f9768fe",
      "name": "Telegram: getFile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getFile",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $json.payload.file_id }) }}"
      },
      "onError": "continueErrorOutput",
      "notes": "Ruta temporal del archivo (válida 1 hora)."
    },
    {
      "id": "1447fbd8-a194-5782-873a-5e82f3ce48f8",
      "name": "Telegram: descargar archivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/file/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.result.file_path }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "e39042bb-30bd-52fc-a427-21fe10f98da0",
      "name": "Python: guardar y leer archivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CM_API_URL }}/api/internal/telegram/files",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "parameterType": "formData",
              "name": "telegram_user_id",
              "value": "={{ $('Recibir archivo').item.json.payload.telegram_user_id }}"
            },
            {
              "parameterType": "formData",
              "name": "purpose",
              "value": "={{ $('Recibir archivo').item.json.payload.purpose }}"
            },
            {
              "parameterType": "formData",
              "name": "file_unique_id",
              "value": "={{ $('Recibir archivo').item.json.payload.file_unique_id }}"
            },
            {
              "parameterType": "formData",
              "name": "file_name",
              "value": "={{ $('Recibir archivo').item.json.payload.file_name }}"
            }
          ]
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Python valida y guarda el archivo DE INMEDIATO (regla fundamental), lo lee con Gemini y devuelve las acciones siguientes. Gemini puede tardar: se espera hasta 120 s."
    },
    {
      "id": "882eb94f-4055-5f30-a752-4c3275ddc56d",
      "name": "Separar acciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "jsCode": "// Una acción = un ítem. Sin acciones, el flujo termina aquí.\nreturn $input.all().flatMap(item => (item.json.actions || []).map(action => ({ json: action })));"
      }
    },
    {
      "id": "f2ee83d7-82af-551f-9bbc-1aef84fac682",
      "name": "Ejecutar acciones",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "cm05EjecutarAcciones",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Si falla, CM-05 ya lo reportó a CM-99."
    },
    {
      "id": "4b1179ad-3f67-57cc-9b10-a0cd1a43002c",
      "name": "Preparar aviso de falla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        220
      ],
      "parameters": {
        "jsCode": "const payload = $('Recibir archivo').first().json.payload;\nconst detail = JSON.stringify($input.first().json.error || $input.first().json).slice(0, 300);\nreturn [{ json: {\n  chat_id: payload.telegram_user_id,\n  text: '⚠️ No pude recibir tu archivo. Envíalo de nuevo en un momento, por favor.',\n  detail,\n}}];"
      }
    },
    {
      "id": "f0160acf-df38-5177-9172-aaeb510c6d17",
      "name": "Telegram: avisar al empleado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b60d0710-bc53-5bbb-91ee-b855b7dbab82",
      "name": "Detener con error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1560,
        220
      ],
      "parameters": {
        "errorMessage": "={{ 'No se pudo procesar un archivo de Telegram: ' + $('Preparar aviso de falla').first().json.detail }}"
      },
      "notes": "Así se dispara CM-99 y el administrador se entera."
    }
  ],
  "connections": {
    "Recibir archivo": {
