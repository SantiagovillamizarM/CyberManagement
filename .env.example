# =====================================================================
# Plantilla de variables de entorno de CyberManagement.
# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio.
#
# Para generar un secreto aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Secretos internos (mínimo 32 caracteres cada uno) ---
SECRET_KEY=
INTERNAL_API_TOKEN=
REGISTRATION_CODE_PEPPER=

# --- PostgreSQL (base de datos de la aplicación) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cybermanagement
POSTGRES_USER=cm_app
POSTGRES_PASSWORD=

# --- PostgreSQL (base de datos de n8n) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# --- n8n ---
# Cifra las credenciales guardadas en n8n. Si se pierde, hay que volver a crearlas.
N8N_ENCRYPTION_KEY=
# URL pública HTTPS para recibir webhooks de Telegram (se define en la Fase 4).
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Empresa y administrador inicial del panel ---
# Nombre de la empresa (se puede cambiar después desde el panel).
COMPANY_NAME=Mi Empresa S.A.S.
ADMIN_EMAIL=admin@cybermanagement.com
ADMIN_INITIAL_PASSWORD=

# --- APIs externas ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcionales (estos son los valores por defecto):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=45
# AI_MIN_CONFIDENCE=0.5
# @BotFather en Telegram
# Secreto que Telegram envía en cada webhook (A-Z, a-z, 0-9, _ y -; mínimo 32).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
# Chat donde el administrador recibe avisos (gastos por revisar, errores). Para saber el
# tuyo, escríbele a @userinfobot en Telegram. Vacío = sin avisos al administrador.
ADMIN_TELEGRAM_CHAT_ID=
